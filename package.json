{
  "name": "pedrobicas-portfolio",
  "version": "2.1.0",
  "private": true,
  "description": "Portfólio pessoal de Pedro Bicas, construído com React, Vite, GSAP, Lenis e Canvas.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Pedro Bicas",
  "homepage": "https://pedrobicas.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrobicas/pedrobicas.com.git"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "check": "npm run lint && npm run format:check && npm run test:unit && npm run build",
    "verify": "npm run check && npm run test:e2e:install && npm run test:e2e",
    "lockfile": "npm install --package-lock-only"
  },
  "dependencies": {
    "gsap": "3.12.5",
    "lenis": "1.3.26",
    "react": "18.3.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "vite": "6.4.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
